# 把本文件复制为 .env，并填写你自己的兼容 Chat Completions 的服务地址和密钥。
# 地址例子格式：https://provider.example.com/v1
NAV_BASE_URL=
NAV_API_KEY=
NAV_MODEL=deepseek-v4-flash

QUIZ_BASE_URL=
QUIZ_API_KEY=
QUIZ_MODEL=doubao-seed-2-0-lite-260428

# 可选：本地教材所在目录；运行索引程序时会读取目录中的 PDF。
KNOWLEDGE_SOURCE_DIR=

HOST=127.0.0.1
PORT=8765
